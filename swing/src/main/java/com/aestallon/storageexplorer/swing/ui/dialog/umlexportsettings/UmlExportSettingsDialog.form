<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.aestallon.storageexplorer.swing.ui.dialog.umlexportsettings.UmlExportSettingsDialog">
  <grid id="cbd77" binding="contentPane" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="48" y="54" width="1240" height="415"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="94766" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <hspacer id="98af6">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <grid id="9538f" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="e7465" class="javax.swing.JButton" binding="buttonOK">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="OK"/>
                </properties>
              </component>
              <component id="5723f" class="javax.swing.JButton" binding="buttonCancel">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Cancel"/>
                </properties>
              </component>
              <component id="910bf" class="javax.swing.JButton" binding="buttonApply">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Apply"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="e3588" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="528d0" class="javax.swing.JCheckBox" binding="checkBoxDetailComplexProps">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <selected value="true"/>
              <text value="&lt;HTML&gt;&lt;H3&gt;Detail Complex Properties&lt;/H4&gt;&#10;&#10;&lt;P&gt;&lt;EM&gt;Complex properties (such as embedded objects, a.k.a details) should be displayed as separate sub-entities, with a composition relation drawn from the parent entity.&lt;/EM&gt;&lt;/P&gt;&lt;/HTML&gt;" noi18n="true"/>
            </properties>
          </component>
          <component id="d5973" class="javax.swing.JCheckBox" binding="checkBoxDrawEdgesFromProps">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="&lt;HTML&gt;&lt;H3&gt;Draw Edges from Source Properties&lt;/H3&gt;&#10;&#10;&lt;P&gt;&lt;EM&gt;If ticked, edges representing relations (dependency, composition etc.) are drawn from the position where the corresponding property is displayed on the host entity.&lt;/EM&gt;&lt;/P&gt;&#10;&#10;&lt;P&gt;&lt;EM&gt;If unticked, edges are drawn as appropriate.&lt;/EM&gt;&lt;/P&gt;&lt;/HTML&gt;"/>
            </properties>
          </component>
          <component id="4677b" class="javax.swing.JCheckBox" binding="checkBoxLabelEdges">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="&lt;HTML&gt;   &lt;H3&gt;Label Edges&lt;/H3&gt;      &lt;P&gt;&lt;EM&gt;If ticked, edges are labeled with the name of the originating property. If &lt;CODE&gt;Detail Complex Properties&lt;/CODE&gt; is not ticked, the label will contain the full property path on the host entity defining the relation.&lt;/EM&gt;&lt;/P&gt; &lt;/HTML&gt;"/>
            </properties>
          </component>
          <component id="c6c35" class="javax.swing.JCheckBox" binding="checkBoxDIsplayArity">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="&lt;HTML&gt;&#10;  &lt;H3&gt;Display Arity&lt;/H3&gt;&#10;  &#10;  &lt;P&gt;&lt;EM&gt;If ticked, edges endpoints are labeled with &lt;CODE&gt;1&lt;/CODE&gt; and &lt;CODE&gt;*&lt;/CODE&gt; to denote one-to-one and one-to-many relations.&lt;/EM&gt;&lt;/P&gt;&#10;&lt;/HTML&gt;"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
